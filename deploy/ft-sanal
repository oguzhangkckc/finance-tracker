#!/usr/bin/env bash
# Sunucuda sanal portföy komutu: ft-finans gibi, ama FT_PROFILE=sanal ve yalnızca EVDS ile
# Telegram sırlarıyla (K-107, K-111). Onay isteyen komutlar --pipe ile terminale bağlanır.
# Kullanım: sudo ft-sanal sanal al KOD --tutar 5000 --tarih 2026-06-15 (/usr/local/bin bağıyla)
set -euo pipefail

credentials=()
for name in ft_evds_api_key ft_telegram_bot_token; do
  credentials+=(-p "LoadCredential=$name:/etc/finans/credstore/$name")
done
# K-126: doctor web'in şifre özetini de denetler. Dosya yoksa systemd birimi hiç başlatmaz;
# bu yüzden yalnız varsa yüklenir ve yokluğunu doctor bildirir. Diğer komutlar özeti görmez.
if [ "${1:-}" = doctor ] && [ -e /etc/finans/credstore/ft_web_password ]; then
  credentials+=(-p "LoadCredential=ft_web_password:/etc/finans/credstore/ft_web_password")
fi

exec systemd-run --quiet --pipe --wait --collect \
  --uid=finans --gid=finans --working-directory=/var/lib/finans \
  -p EnvironmentFile=/etc/finans/finans.env \
  -p Environment=FT_PROFILE=sanal \
  "${credentials[@]}" \
  -p NoNewPrivileges=yes -p PrivateTmp=yes -p ProtectSystem=strict \
  -p ReadWritePaths=/var/lib/finans -p ProtectHome=yes \
  /opt/finans/current/.venv/bin/ft "$@"
