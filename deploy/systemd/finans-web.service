[Unit]
Description=finans-takip web arayüzü ve JSON API (127.0.0.1, Cloudflare tüneli ve Access arkasında)
Documentation=file:/opt/finans/docs/DESIGN.md

[Service]
Type=exec
User=finans
Group=finans
WorkingDirectory=/var/lib/finans
EnvironmentFile=/etc/finans/finans.env
# K-106: işlerin sırları yüklenmez; profil drop-in'de seçilir (K-123).
LoadCredential=ft_web_session_key:/etc/finans/credstore/ft_web_session_key
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# K-123: WAL'da salt okunur bağlantı da -shm dosyasına yazar; istek dosyası da bu dizinde.
ReadWritePaths=/var/lib/finans
ProtectHome=yes
# K-136: Access anahtarları (JWKS) internetten çekilir, uygulama 127.0.0.1'de TCP dinler.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
PrivateDevices=yes
PrivateMounts=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ExecStart=/opt/finans/.venv/bin/finans-api
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
