[Unit]
Description=finans-takip web arayüzü (yalnız tailnet, Unix soketi)
Documentation=file:/opt/finans/docs/DESIGN.md

[Service]
Type=exec
User=finans
Group=finans
WorkingDirectory=/var/lib/finans
EnvironmentFile=/etc/finans/finans.env
# K-106: işlerin sırları yüklenmez; profil drop-in'de seçilir (K-123).
LoadCredential=ft_web_session_key:/etc/finans/credstore/ft_web_session_key
# K-123: soket /run/finans-web/web.sock; uvicorn'un 0666'sı yerine adapter 0600 verir.
RuntimeDirectory=finans-web
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# K-123: WAL'da salt okunur bağlantı da -shm dosyasına yazar; istek dosyası da bu dizinde.
ReadWritePaths=/var/lib/finans
ProtectHome=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
PrivateDevices=yes
PrivateMounts=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ExecStart=/opt/finans/.venv/bin/finans-web
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
