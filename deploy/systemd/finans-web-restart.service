[Unit]
Description=finans-takip web'i yeniden başlatma (deploy, parametresiz, K-133)
Documentation=file:/opt/finans/current/docs/DESIGN.md

[Service]
Type=oneshot
# K-133: root gerektiren tek adım. Parametresi yoktur; istek dosyasının içeriği okunmaz, dışarıdan
# hiçbir değer komuta girmez. sudo yerine bu birim: çalıştırıcıda NoNewPrivileges korunur.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/finans-deploy/calisma
ProtectHome=yes
PrivateNetwork=yes
# İstek dosyası finans'ın 0700 dizinindedir; silmek için yalnız bu yetenek gerekir.
CapabilityBoundingSet=CAP_DAC_OVERRIDE
RestrictAddressFamilies=AF_UNIX
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryDenyWriteExecute=yes
ProtectClock=yes
ProtectHostname=yes
RemoveIPC=yes
UMask=0077
ExecStartPre=/usr/bin/rm -f /var/lib/finans-deploy/calisma/web-yeniden-baslat
ExecStart=/usr/bin/systemctl restart finans-web.service
