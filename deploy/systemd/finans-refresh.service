[Unit]
Description=finans-takip elle fiyat güncellemesi
Documentation=file:/opt/finans/current/docs/DESIGN.md
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=oneshot
User=finans
Group=finans
WorkingDirectory=/var/lib/finans
EnvironmentFile=/etc/finans/finans.env
LoadCredential=ft_evds_api_key:/etc/finans/credstore/ft_evds_api_key
LoadCredential=ft_telegram_bot_token:/etc/finans/credstore/ft_telegram_bot_token
LoadCredential=ft_healthcheck_reports_url:/etc/finans/credstore/ft_healthcheck_reports_url
LoadCredential=ft_healthcheck_backup_url:/etc/finans/credstore/ft_healthcheck_backup_url
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/finans
ProtectHome=yes
# K-123: istek önce silinir; iş sürerken gelen yeni istek iş bitince .path birimini yeniden tetikler.
ExecStartPre=/usr/bin/rm -f /var/lib/finans/refresh/real.request
ExecStart=/opt/finans/current/.venv/bin/ft job run sync-prices --bugun
