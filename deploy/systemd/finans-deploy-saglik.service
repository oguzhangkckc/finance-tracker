[Unit]
Description=finans-takip deploy sağlık denetimi (iki profilde doctor, ağsız)
Documentation=file:/opt/finans/current/docs/DESIGN.md

[Service]
Type=oneshot
User=finans
Group=finans
WorkingDirectory=/var/lib/finans
EnvironmentFile=/etc/finans/finans.env
# K-133: doctor işlerle ve elle doctor'la (ft-finans, ft-sanal) aynı kimlik bilgileriyle çalışır; biri
# eksik olsa doctor ✗ verir ve her deploy geri alınırdı. Sırları çalıştırıcı değil, yalnız bu ağsız birim görür.
LoadCredential=ft_evds_api_key:/etc/finans/credstore/ft_evds_api_key
LoadCredential=ft_telegram_bot_token:/etc/finans/credstore/ft_telegram_bot_token
LoadCredential=ft_healthcheck_reports_url:/etc/finans/credstore/ft_healthcheck_reports_url
LoadCredential=ft_healthcheck_backup_url:/etc/finans/credstore/ft_healthcheck_backup_url
LoadCredential=ft_web_password:/etc/finans/credstore/ft_web_password
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/finans /var/lib/finans-deploy/saglik
ProtectHome=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
SystemCallFilter=@system-service
MemoryDenyWriteExecute=yes
UMask=0077
PrivateMounts=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
ExecStartPre=/usr/bin/rm -f /var/lib/finans-deploy/saglik/istek
# Çıktıyı systemd değil kabuk yazar: dosya finans'ın olur ve çalıştırıcı ✗ satırlarını okuyabilir.
ExecStart=/bin/sh -c 'exec /opt/finans/current/.venv/bin/ft doctor >> /var/lib/finans-deploy/saglik/doctor.txt 2>&1'
ExecStart=/bin/sh -c 'FT_PROFILE=sanal exec /opt/finans/current/.venv/bin/ft doctor >> /var/lib/finans-deploy/saglik/doctor.txt 2>&1'
ExecStopPost=/bin/sh -c 'printf "%%s\n" "$$SERVICE_RESULT" > /var/lib/finans-deploy/saglik/sonuc'
