# /etc/finans/finans.env için örnek (root:finans, 640). Sır yazılmaz; sırlar
# /etc/finans/credstore/ altında, LoadCredential ile verilir (K-92):
#   ft_evds_api_key, ft_telegram_bot_token, ft_healthcheck_reports_url, ft_healthcheck_backup_url
#   ft_web_session_key (yalnız finans-web.service; onay jetonunun anahtarı, en az 32 karakter, K-137)
FT_DB_PATH=/var/lib/finans/finans.db
FT_PORTFOLIO_PATH=/etc/finans/portfolio.toml
FT_LOCK_DIR=/var/lib/finans/locks
FT_BACKUP_DIR=/var/lib/finans/backups
# Yalnızca açık anahtarlar (age1…), virgülle ayrılmış: Mac anahtarı ve kurtarma anahtarı (K-82).
FT_BACKUP_AGE_RECIPIENTS=
FT_TELEGRAM_CHAT_ID=
FT_WEEKLY_REPORT_ENABLED=false
FT_LOG_LEVEL=INFO
# Web arayüzü ve JSON API (K-136, K-137): alan adının kökeni (https://<alt alan>.<alan adı>),
# Access takım adresi (<takım>.cloudflareaccess.com), uygulamanın AUD etiketi ve izinli e-posta.
# Biri eksikse finans-web.service açılmaz; ft ve işler bunları istemez. FT_WEB_PORT doluysa deploy
# betiği sağlık ucunu 127.0.0.1'de yoklar. FT_WEB_HOST boşsa 127.0.0.1; yalnız loopback kabul edilir.
# Profil burada değil, servisin drop-in'inde seçilir.
FT_WEB_ORIGIN=
FT_WEB_HOST=
FT_WEB_PORT=
FT_CF_ACCESS_TEAM_DOMAIN=
FT_CF_ACCESS_AUD=
FT_WEB_ALLOWED_EMAIL=
# Derlenmiş arayüzün dizini (K-139); mutlak yol, boşsa deploy'un açtığı /opt/finans/frontend/dist.
FT_WEB_DIST=
